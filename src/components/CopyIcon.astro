---
// Two overlapping sheets: the icon of the compact copy button (CopyEmail.astro), matching the filled icons.
// Decorative: the button around it carries the accessible name. Takes the text color (fill="currentColor").
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  data-icon="copy"
>
  <path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"></path>
</svg>
