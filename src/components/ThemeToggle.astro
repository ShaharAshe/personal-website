---
// Dark/light toggle for the nav. An Astro component with a small script, not a React island: React
// would ship ~45-60KB of JS on every page for one button. Logic lives in src/lib/theme.ts. The script also wires the
// footer's terminal view switch (StyleToggle.astro). In terminal view global.css hides this button: terminal is
// always dark.
//
// Both icons are in the markup and CSS shows the one for the theme a click switches to (sun in dark,
// moon in light), resolved like the color tokens, so the icon is right before any JS runs. The
// build-time aria-label is neutral; the script replaces it with "Switch to light/dark theme".
//
// Both switches also set the tab icon (Task 2.21a): the SVG icon link's href becomes the icon for the new choice, a
// theme's fixed variant or terminal view's ">_" (Task 2.21b; faviconFor() in src/lib/theme.ts), with no reload.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch color theme"
  class="inline-flex size-10 shrink-0 items-center justify-center rounded-md border border-border text-text-muted hover:text-text"
>
  <svg
    data-theme-icon="light"
    aria-hidden="true"
    focusable="false"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    data-theme-icon="dark"
    aria-hidden="true"
    focusable="false"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  /* Dark (also the default with no OS preference): offer light. */
  [data-theme-icon='dark'] {
    display: none;
  }

  :global(:root[data-theme='light']) [data-theme-icon='light'] {
    display: none;
  }
  :global(:root[data-theme='light']) [data-theme-icon='dark'] {
    display: block;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) [data-theme-icon='light'] {
      display: none;
    }
    :global(:root:not([data-theme])) [data-theme-icon='dark'] {
      display: block;
    }
  }

  /*
   * The colors crossfade with the whole page (the script's View Transition, Task 3.4); the new icon also turns in. data-animate is set on the first click, so
   * nothing plays on page load. Each click displays the other <svg>, which restarts the animation.
   * No rule at all under prefers-reduced-motion: reduce.
   */
  @media (prefers-reduced-motion: no-preference) {
    [data-animate] svg {
      animation: theme-icon-in 200ms ease-out;
    }
  }

  @keyframes theme-icon-in {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.8);
    }
  }
</style>

<script>
  import {
    FAVICON_LINK_SELECTOR,
    TERMINAL,
    currentStyle,
    currentTheme,
    faviconFor,
    nextStyle,
    nextTheme,
    saveStyle,
    saveTheme,
    toggleLabel,
  } from '../lib/theme';

  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // The choices on screen, kept here rather than read back from <html>: with the fade, <html> changes a frame later, and
  // a quick second click must still toggle back. `chosen` is the theme saved by a click (else <html>'s data-theme).
  let style = currentStyle(root.dataset.style);
  let chosen: string | undefined;

  // The tab icon follows every click at once (Task 2.21a): the fixed variant for the choice, as the head script does on
  // load. Outside the fade: it doesn't depend on <html>.
  const setIcon = () =>
    document
      .querySelector(FAVICON_LINK_SELECTOR)
      ?.setAttribute('href', faviconFor(chosen ?? root.dataset.theme, style));

  // Both switches crossfade the whole page (Task 3.4): a View Transition whose root snapshots only fade (global.css),
  // 200ms. Instant where the browser has no startViewTransition, and with reduced motion. Only the change to <html> goes
  // in the callback; saving, the label and aria-pressed follow right away.
  const withFade = (update: () => void) => {
    if ('startViewTransition' in document && !reduceMotion.matches) document.startViewTransition(update);
    else update();
  };

  // The footer's terminal view switch (src/components/StyleToggle.astro) is wired here, so the site keeps one inline
  // script for both choices.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-style-toggle]')) {
    button.setAttribute('aria-pressed', String(style === TERMINAL));

    button.addEventListener('click', () => {
      const next = nextStyle(style);
      style = next;
      withFade(() => {
        if (next === TERMINAL) root.dataset.style = next;
        else delete root.dataset.style;
      });
      saveStyle(next, () => localStorage);
      setIcon();
      button.setAttribute('aria-pressed', String(next === TERMINAL));
    });
  }
  const osLight = matchMedia('(prefers-color-scheme: light)');
  const read = () => currentTheme(chosen ?? root.dataset.theme, osLight.matches);

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const updateLabel = () => button.setAttribute('aria-label', toggleLabel(read()));
    updateLabel();

    button.addEventListener('click', () => {
      const next = nextTheme(read());
      chosen = next;
      withFade(() => {
        root.dataset.theme = next;
      });
      saveTheme(next, () => localStorage);
      setIcon();
      updateLabel();
      button.dataset.animate = '';
    });

    // While nothing is saved the page follows the OS live (CSS); keep the label in step.
    osLight.addEventListener('change', updateLabel);
  }
</script>
