---
// One /resume section: an <h2> and its content, in the site's 720px column. Spacing matches Skills.astro, which
// /resume reuses as is, and comes from --section-gap, which the page sets.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-[720px] px-4 pt-(--section-gap)">
    <h2 id={`${id}-title`} class="text-xl font-semibold tracking-tight">
      {title}
    </h2>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
