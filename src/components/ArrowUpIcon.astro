---
// An up arrow: the marker for the footer's Back to top link (.claude/rules/ui.md). An SVG, so it can't
// render as an emoji on a phone. Decorative: the link around it carries the accessible name. Takes the
// text color.
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  data-icon="arrow-up"
>
  <path d="M12 19V5M6 11l6-6 6 6"></path>
</svg>
