---
// Homepage Hero (design-doc §5.1): name (the page's only <h1>), title, one-line tagline, the two CTAs
// and profile icon links. All text comes from resume.yaml via src/lib/hero.ts. Ships no JS.
//
// "Download Resume" is the section's one accent-filled button. The download attribute makes it save the
// PDF; a plain link to /resume.pdf opens it in the browser (public/_headers serves it inline).
// The email icon is added in Task 2.9, with the CopyEmail component that assembles it in the browser.
// Profile links open in the same tab (no target="_blank").
import GitHubIcon from './GitHubIcon.astro';
import { heroContent } from '../lib/hero';
import { getResume } from '../lib/resume';
import { RESUME_PDF_FILENAME, RESUME_PDF_URL } from '../lib/resume-pdf';

const { name, title, tagline, socials } = heroContent(getResume());
---

<section aria-labelledby="hero-title" data-hero class="hero relative isolate overflow-hidden">
  <div class="mx-auto max-w-[720px] px-4 py-20 sm:py-28">
    <h1 id="hero-title" class="text-display font-semibold tracking-tight">
      {name}
    </h1>
    <p data-hero-role class="mt-4 font-mono text-sm text-accent sm:text-base">
      {title}
    </p>
    <p data-hero-tagline class="mt-6 max-w-[60ch] text-text-muted">
      {tagline}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={RESUME_PDF_URL}
        download={RESUME_PDF_FILENAME}
        class="inline-flex items-center rounded-md bg-accent px-5 py-2.5 font-medium text-on-accent hover:opacity-90"
      >
        Download Resume
      </a>
      <a
        href="/#projects"
        class="inline-flex items-center rounded-md border border-border px-5 py-2.5 font-medium hover:border-text-muted"
      >
        View Projects
      </a>
    </div>

    <ul class="mt-6 flex gap-2" aria-label="Profiles">
      {socials.map(({ network, url, icon }) => (
        <li>
          <a
            href={url}
            aria-label={network}
            data-social={icon}
            class="inline-flex size-10 items-center justify-center rounded-md text-text-muted hover:text-text"
          >
            {icon === 'github' && <GitHubIcon size={20} />}
            {icon === 'linkedin' && (
              <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Subtle dot grid (design-doc §5.1: at most a subtle background), faded out toward the edges. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
  }
</style>
