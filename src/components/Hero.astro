---
// Homepage Hero (design-doc §5.1): name (the page's only <h1>), title, one-line tagline, the two CTAs
// and profile icon links. All text comes from resume.yaml via src/lib/hero.ts. Ships no JS (on a doodle day, the
// Doodle brings its own small script).
//
// "Download Resume" is the section's one accent-filled button. The download attribute makes it save the
// PDF; a plain link to /resume.pdf opens it in the browser (public/_headers serves it inline).
// The email icon (last in the row) is an EmailLink: no href in the HTML, and its item is `hidden` until
// the page's email script (in CopyEmail.astro, rendered by Contact) joins the address and sets the
// mailto: href. So the Hero itself still ships no script, and without JS the icon isn't shown.
// Profile links open in the same tab (no target="_blank").
//
// On a doodle day (Task F.4, src/lib/doodles/), the day's Doodle sits at the right end of the profile row, chosen at
// build time (the daily CI build) or forced with DOODLE=<id> for a preview build (npm run doodle:build). Other days
// render no Doodle, so no page gets its markup or script.
import Doodle from './Doodle.astro';
import EmailLink from './EmailLink.astro';
import GitHubIcon from './GitHubIcon.astro';
import LinkedInIcon from './LinkedInIcon.astro';
import MailIcon from './MailIcon.astro';
import { selectDoodle } from '../lib/doodles/select';
import { heroContent } from '../lib/hero';
import { getResume } from '../lib/resume';
import { RESUME_PDF_FILENAME, RESUME_PDF_URL } from '../lib/resume-pdf';
import { LAUNCH_DATE } from '../lib/site';

const { name, title, tagline, socials } = heroContent(getResume());
const doodle = selectDoodle({ now: new Date(), env: process.env.DOODLE, launchDate: LAUNCH_DATE });
---

{/* The background layers: remove hero-dots or hero-glow from this class list to turn that layer off. */}
<section aria-labelledby="hero-title" data-hero class="hero-dots hero-glow relative isolate">
  <div class="mx-auto max-w-[720px] px-4 pt-20 sm:pt-28">
    <h1 id="hero-title" class="text-display font-semibold tracking-tight">
      {name}
    </h1>
    <p data-hero-role class="mt-4 font-mono text-sm text-accent sm:text-base">
      {title}
    </p>
    <p data-hero-tagline class="mt-6 max-w-[60ch] text-text-muted">
      {tagline}
    </p>

    {/* data-no-brackets: button-style and icon-only links don't get terminal view's [brackets] (global.css). */}
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={RESUME_PDF_URL}
        download={RESUME_PDF_FILENAME}
        data-no-brackets
        class="inline-flex items-center rounded-md bg-accent px-5 py-2.5 font-medium text-on-accent hover:opacity-90"
      >
        Download Resume
      </a>
      <a
        href="/#projects"
        data-no-brackets
        class="inline-flex items-center rounded-md border border-border px-5 py-2.5 font-medium hover:border-text-muted"
      >
        View Projects
      </a>
    </div>

    {/* -ml-2.5: the 20px icons are centered in 40px hit areas, so this lines their left edge up with the text. */}
    <div class="mt-6 flex items-center">
      <ul class="-ml-2.5 flex gap-2" aria-label="Profiles">
        {socials.map(({ network, url, icon }) => (
          <li>
            <a
              href={url}
              aria-label={network}
              data-social={icon}
              data-no-brackets
              class="inline-flex size-10 items-center justify-center rounded-md text-text-muted hover:text-text"
            >
              {icon === 'github' && <GitHubIcon size={20} />}
              {icon === 'linkedin' && <LinkedInIcon size={20} />}
            </a>
          </li>
        ))}
        <li data-email-reveal hidden>
          <EmailLink
            aria-label="Email"
            noBrackets
            class="inline-flex size-10 items-center justify-center rounded-md text-text-muted hover:text-text"
          >
            <MailIcon size={20} />
          </EmailLink>
        </li>
      </ul>
      {doodle && <Doodle doodle={doodle} />}
    </div>
  </div>
</section>

<style>
  /* Dot grid in the margins only (design-doc §5.1). The first mask is transparent across the 720px text
     column, so no dot is ever under the content, and at 720px wide or less no dots show at all. The second
     fades the grid out at the Hero's top and bottom. */
  .hero-dots::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--hero-dot) 2px, transparent 2px);
    background-size: 24px 24px;
    mask-image:
      linear-gradient(
        to right,
        black calc(50% - 520px),
        transparent calc(50% - 360px),
        transparent calc(50% + 360px),
        black calc(50% + 520px)
      ),
      linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
    mask-composite: intersect;
  }

  /* Soft accent glow behind the heading. tests/design-tokens.test.ts checks the text against its strongest point. */
  .hero-glow::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(ellipse 60% 70% at 35% 35%, var(--hero-glow), transparent);
  }
</style>
