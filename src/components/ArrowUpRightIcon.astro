---
// An up-right arrow: the marker for links that leave the site (.claude/rules/ui.md). An SVG, because the
// U+2197 character renders as a colored emoji on many phones. Decorative: the link around it carries the
// accessible name. Takes the text color.
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  data-icon="arrow-up-right"
>
  <path d="M7 17 17 7M8 7h9v9"></path>
</svg>
