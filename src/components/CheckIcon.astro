---
// A check mark: replaces CopyIcon on a copy button after a successful copy. An SVG, because the check characters
// can render as a colored emoji on phones. Decorative: the button around it carries the accessible name. Takes the
// text color (fill="currentColor"), so success adds no new color.
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  data-icon="check"
>
  <path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
</svg>
