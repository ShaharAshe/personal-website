---
// An envelope outline: the marker for mailto: links (the Hero email icon and Contact's "Open in mail
// app"). Decorative: the link around it carries the accessible name. Takes the text color.
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  data-icon="mail"
>
  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
  <path d="m22 7-10 6L2 7"></path>
</svg>
