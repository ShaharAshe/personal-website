---
// The homepage: Hero, Experience, Projects, Skills, Contact. The footer comes from BaseLayout.
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import { getResume } from '../lib/resume';

// No resume text in this file (hard rule 1). Full SEO tags come in Task 2.13.
const { name, label } = getResume().basics;
---

<BaseLayout title={name} description={`${name} – ${label}.`}>
  <Hero />
  <Experience />
  <Projects />
  <Skills />
  <Contact />
</BaseLayout>
