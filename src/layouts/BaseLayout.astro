---
// Shared page shell: <head> (no-flash theme script, title/description, canonical, Open Graph, fonts), skip link,
// nav (with the home link), footer. Every absolute URL comes from `site` in astro.config.mjs (src/lib/seo.ts).
// Page-specific head tags (the homepage's JSON-LD) go in the "head" slot.
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getResume } from '../lib/resume';
import { OG_IMAGE, SITE_ICONS, absoluteUrl, iconSizesAttr, ogImageAlt } from '../lib/seo';
import { themeInitScript } from '../lib/theme';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
  /** The footer's Back to top link. Pages too short to scroll turn it off (the 404 page). */
  backToTop?: boolean;
}

const { title, description, noindex = false, backToTop = true } = Astro.props;

const navLinks = [
  { label: 'Experience', href: '/#experience' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Resume', href: '/resume' },
  { label: 'Contact', href: '/#contact' },
];

// The built path can end in a slash (/resume/). The homepage's section links (/#...) never match a path.
const currentPath = Astro.url.pathname.replace(/\/+$/, '');

const { name, label } = getResume().basics;
// A noindex page (the 404 page) has no canonical and no og:url: it isn't a page to index or share.
const canonical = noindex ? undefined : absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(OG_IMAGE.path, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Must stay before any stylesheet: sets data-theme before first paint (src/lib/theme.ts). */}
    <script is:inline set:html={themeInitScript} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* Site icons (npm run og). Root-relative, so they work on any host. */}
    <link rel="icon" href={SITE_ICONS.favicon.path} sizes={iconSizesAttr(SITE_ICONS.favicon.sizes)} />
    <link
      rel="apple-touch-icon"
      href={SITE_ICONS.appleTouch.path}
      sizes={iconSizesAttr([SITE_ICONS.appleTouch.size])}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:alt" content={ogImageAlt(name, label)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {/* Preload only body text (Inter 400); other weights load on demand. */}
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body class="flex min-h-screen flex-col">
    {/* The footer's Back to top target: following the link scrolls here and moves focus here, so the next
        Tab lands on the skip link. tabindex="-1": focusable by the link, never a Tab stop. */}
    <div id="top" tabindex="-1" role="group" aria-label="Top of page"></div>

    {/* Skip link: first Tab stop, moved above the viewport until focused. */}
    <a
      href="#main"
      class="fixed top-4 left-4 z-50 -translate-y-[200%] rounded-md bg-accent px-4 py-2 font-medium text-on-accent focus:translate-y-0"
    >
      Skip to content
    </a>

    <header class="border-b border-border">
      <nav aria-label="Main" class="mx-auto flex max-w-[720px] items-center justify-end gap-4 px-4 py-4 sm:gap-6">
        {/* Home link: muted site chrome. Hidden below sm, where the nav has no room for it (the page itself starts
            with the name there); mr-auto pushes the links and toggle to the right. */}
        <a
          href="/"
          data-home-link
          class="mr-auto hidden min-h-10 shrink-0 items-center font-medium text-text-muted hover:text-text sm:inline-flex"
        >
          {name}
        </a>
        {/* Tighter gaps below sm keep links + toggle on one line at 375px; min-w-0 + flex-wrap let the
            links wrap (never overflow) on anything narrower. */}
        <ul class="flex min-w-0 flex-wrap justify-end gap-x-4 gap-y-2 text-sm sm:gap-x-6">
          {navLinks.map(({ label, href }) => (
            <li>
              {/* Current page: --text and an underline, not accent (site chrome stays muted, .claude/rules/ui.md). */}
              <a
                href={href}
                aria-current={href === currentPath ? 'page' : undefined}
                class="text-text-muted underline-offset-4 hover:text-text aria-[current=page]:text-text aria-[current=page]:underline"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <ThemeToggle />
      </nav>
    </header>

    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <Footer backToTop={backToTop} />
  </body>
</html>
