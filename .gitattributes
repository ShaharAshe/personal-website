# Line endings: text files are always LF, in git and in the working tree, on every OS and regardless
# of core.autocrlf. Prettier and the golden test fixtures expect LF.
* text=auto eol=lf

# Binary files: never converted or diffed as text.
*.pdf   binary
*.docx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
