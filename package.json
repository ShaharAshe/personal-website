{
  "name": "personal-website",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "cv": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cv/validate-resume.ts && node --env-file-if-exists=.env scripts/cv/create_cv.js && node --env-file-if-exists=.env scripts/cv/to-pdf.js && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cv/check-pdf.ts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "build": "npm run cv && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx": "^9.12.0",
    "js-yaml": "^4.3.2",
    "pdf-parse": "^2.4.5",
    "typescript": "^6.0.3"
  }
}
