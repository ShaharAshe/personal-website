# Copy to .env and fill in locally. Never commit the real .env — see .gitignore.
# Phone number for the resume PDF/DOCX only. The website never reads this.
CV_PHONE=

# Optional: full path to LibreOffice's soffice(.exe), used by `npm run cv` to convert Word -> PDF.
# Only needed if LibreOffice isn't at C:\Program Files\LibreOffice\program\soffice.exe and
# `soffice` isn't on your PATH (e.g. a portable or non-default install).
# SOFFICE_PATH=D:\Apps\LibreOffice\program\soffice.exe
